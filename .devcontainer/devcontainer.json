{
  "name": "Windower Addons",
  "build": { "dockerfile": "Dockerfile" },
  "customizations": {
    "vscode": {
      "extensions": [
        "sumneko.lua",
        "johnnymorganz.stylua",
        "Anthropic.claude-code"
      ],
      "settings": {
